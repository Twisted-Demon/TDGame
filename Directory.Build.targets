<Project>
    <PropertyGroup>
        <TDGameContentRoot>$(MSBuildThisFileDirectory)TDGame.Core/Content/</TDGameContentRoot>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsTDGameHost)' == 'true'">
        <Content Include="
        $(TDGameContentRoot)**/*.xnb;
        $(TDGameContentRoot)**/*.ttf;
        $(TDGameContentRoot)**/*.pak">

            <Link>Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
            <TargetPath>Content/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>

            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
</Project>