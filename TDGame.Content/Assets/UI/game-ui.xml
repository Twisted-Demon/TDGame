<Ui>
    <Grid id="view-surface"
          width="100%" height="100%"
          columns="*,15%">
        
        <!-- The first column is deliberately empty. The world renders beneath it -->
        
        <!-- outer edge -->
        <Border grid-column="1"
                width="100%" height="100%"
                padding="4"
                background-tint="#0a0a0a">
            <Border.Background>
                <SolidColorBrush/>
            </Border.Background>
            
            <!-- Main panel -->
            <Border width="100%" height="100%"
                     padding="8"
                     background-tint="#292929">
                <Border.Background>
                    <SolidColorBrush/>
                </Border.Background>
                
                <Grid width="100%" height="100%"
                      rows="10%,*" spacing="4">
                    
                    <!-- Main title -->
                    <Border grid-row="0"
                            width="100%"
                            height="100%"
                            padding="4"
                            background-tint="#0a0a0a">
                        <Border.Background>
                            <SolidColorBrush />
                        </Border.Background>

                        <Border width="100%"
                                height="100%"
                                background-tint="#575757">
                            <Border.Background>
                                <SolidColorBrush />
                            </Border.Background>

                            <Text width="100%"
                                  height="100%"
                                  auto-resize-height="true"
                                  multi-line="false"
                                  text="Defenses"
                                  font="monogram"
                                  font-size="22"
                                  text-color="#FFFFFFFF"
                                  horizontal-alignment="Center" />
                        </Border>
                    </Border>

                    <!-- Tower Cards -->
                    <Border grid-row="1"
                            width="100%"
                            height="100%"
                            padding="4"
                            background-tint="#0a0a0a">
                        <Border.Background>
                            <SolidColorBrush />
                        </Border.Background>

                        <Border width="100%"
                                height="100%"
                                background-tint="#575757">
                            <Border.Background>
                                <SolidColorBrush />
                            </Border.Background>

                            <VerticalStackPanel id="tower-cards-stack" 
                                                spacing="4" padding="4">
                                
                            </VerticalStackPanel>
                        </Border>
                    </Border>
                </Grid>  
            </Border>
        </Border>
    </Grid>
</Ui>