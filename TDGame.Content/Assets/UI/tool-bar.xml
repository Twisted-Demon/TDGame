          width="*"
          height="*"
          text="Wave: 0"
          font="monogram"
          text-color="#FFFFFFFF"
          font-size="28"
          origin="TopCenter"
          anchor="TopCenter"
          horizontal-alignment="Center"
    />
    
    <Button id="test-button"
            width="15%"
