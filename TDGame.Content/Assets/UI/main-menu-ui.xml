<Ui>
    <Texture width="100%" height="100%" sprite="shared/backgrounds/default-space.sprite"/>
    
    <Grid id="view-surface"
          width="100%" height="100%"
          columns="*,25%"
          background-tint="#333333">
        
        <Border grid-column="1"
                background-tint="#333333">
            
            <VerticalStackPanel cross-alginment="End" grow-direction="Center" padding="16">
                <Text width="100%" height="*"
                      text="Space Game"
                      font="monogram" font-size="48"
                      text-color="#FFFFFF"
                      horizontal-alignment="Right"/>
                
                <Button id="play-button" width="*" height="*">
                    <Text width="100%" height="*"
                          text="Play"
                          font="monogram" font-size="32"
                          text-color="#FFFFFF"
                          horizontal-alignment="Right"/>
                </Button>

                <Button id="settings-button" width="*" height="*">
                    <Text width="100%" height="*"
                          text="Settings"
                          font="monogram" font-size="32"
                          text-color="#FFFFFF"
                          horizontal-alignment="Right"/>
                </Button>

                <Button id="exit-button" width="*" height="*">
                    <Text width="100%" height="*"
                          text="Exit"
                          font="monogram" font-size="32"
                          text-color="#FFFFFF"
                          horizontal-alignment="Right"/>
                </Button>
            </VerticalStackPanel>
        </Border>
    </Grid>
</Ui>